+/* 言同学封面公共样式：米黄旧纸底 #f2e8d3 / 深绿 #2d5a3d / 朱红印章 */
+@font-face { font-family: "ChineseKai"; src: local("KaiTi"); }
+@font-face { font-family: "ChineseSerif"; src: local("SimSun"); }
+* { margin: 0; padding: 0; box-sizing: border-box; }
+html, body { width: 1600px; height: 1200px; overflow: hidden; background: #101010; }
+.cover {
+  position: relative; width: 1600px; height: 1200px; overflow: hidden;
+  background: #f2e8d3;
+  font-family: "ChineseKai", "ChineseSerif", serif; color: #2d5a3d;
+}
+/* 旧纸磨损边缘 */
+.cover::before {
+  content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 5;
+  background:
+    radial-gradient(ellipse at 8% 12%, rgba(120,90,40,.14), transparent 42%),
+    radial-gradient(ellipse at 92% 88%, rgba(120,90,40,.16), transparent 46%),
+    radial-gradient(ellipse at 85% 8%, rgba(90,60,25,.10), transparent 38%);
+}
+/* 纸纹颗粒 */
+.cover::after {
+  content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 6; opacity: .12;
+  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/></filter><rect width='240' height='240' filter='url(%23n)' opacity='0.55'/></svg>");
+  mix-blend-mode: multiply;
+}
+/* 朱红印章"言同学"：右下角默认位置，可用 .seal.bl 等改位置 */
+.seal {
+  position: absolute; width: 150px; height: 150px; z-index: 10;
+  background: #b03a2a; color: #f2e8d3;
+  display: flex; align-items: center; justify-content: center;
+  font-size: 44px; line-height: 1.25; text-align: center; font-weight: bold;
+  /* 做旧磨损 */
